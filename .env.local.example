# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key for tokens at rest (32+ char random string)
ENCRYPTION_KEY=

# Shopify
# App URL — set to your Vercel production URL (no trailing slash)
# Example: https://ai-portal.vercel.app
SHOPIFY_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shopify credentials are per-reseller — configured in portal Settings
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET are no longer required globally

# Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
# Per-merchant tokens are stored encrypted in DB; use this only for initial testing:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Bunny.net — product image storage (Storage Zone password + Pull Zone hostname)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_HOSTNAME=
# Optional regional endpoint prefix, e.g. ny, de, sg (leave empty for default)
BUNNY_STORAGE_REGION=

# Groq AI — WhatsApp sales agent (auto-replies, product search, close deals)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback AI provider
ANTHROPIC_API_KEY=

# PayTabs — per-reseller credentials are saved in Integrations → PayTabs
# (Profile ID + Server Key). Hosted payment API will be wired later.
# Optional platform defaults if you later add a shared merchant account:
# PAYTABS_PROFILE_ID=
# PAYTABS_SERVER_KEY=

# Admin (create once via setup endpoint)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Platform Admin
ADMIN_SETUP_SECRET=change-me-setup-secret
