# ── Required (app won't work without these) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (Gemini is primary; Anthropic is optional fallback) ───────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_UTILITY_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=

# ── Memory (Mem0 + Supabase pgvector) ────────────────────────────────
# Soft-fails if unset — short-term history + profile + summary still work
# Embeddings use GEMINI_API_KEY (gemini-embedding-001)
MEM0_ENABLED=true
DATABASE_URL=

# ── Admin one-time setup (POST /api/auth/setup-admin) ────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
ADMIN_SETUP_SECRET=

# ── Shopify ──────────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_customers,write_draft_orders

# ── Meta / WhatsApp ──────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=

# Optional platform-level WhatsApp fallback (before per-store connect)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# ── BunnyCDN (product image uploads) ─────────────────────────────────
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_HOSTNAME=
BUNNY_STORAGE_REGION=

# ── Optional ─────────────────────────────────────────────────────────
CRON_SECRET=
